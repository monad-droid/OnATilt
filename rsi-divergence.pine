// This Pine Script(TM) indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// OnATilt - RSI Divergence with Neutral Zone Reset
//@version=6
indicator("RSI Divergence (Neutral Reset)", overlay=false, max_lines_count=500, max_labels_count=500)

// ── Inputs ──────────────────────────────────────────────────────
rsiLen        = input.int(14,  "RSI Length")
pivotLookback = input.int(3,   "Pivot Lookback", minval=1, maxval=10)
maxBars       = input.int(14,  "Max Bars Between Pivots", minval=5, maxval=50)
neutralHi     = input.float(52.0, "Neutral Zone Upper")
neutralLo     = input.float(48.0, "Neutral Zone Lower")
bullColor     = input.color(color.green, "Bullish Color")
bearColor     = input.color(color.red,   "Bearish Color")
lineWidth     = input.int(2, "Line Width", minval=1, maxval=5)

// ── RSI ─────────────────────────────────────────────────────────
rsi = ta.rsi(close, rsiLen)
inNeutral = rsi >= neutralLo and rsi <= neutralHi

// ── Price pivot detection ───────────────────────────────────────
// Swing highs/lows on PRICE, then read RSI at that bar
pricePivotLow  = ta.pivotlow(low,   pivotLookback, pivotLookback)
pricePivotHigh = ta.pivothigh(high,  pivotLookback, pivotLookback)
rsiAtPivot     = rsi[pivotLookback]
pivotBarIdx    = bar_index - pivotLookback

// ── Neutral zone reset tracking ─────────────────────────────────
// If RSI touched 48-52 since the last stored pivot, any developing
// divergence is cancelled. The flag resets when a new pivot is stored.
var bool neutralSincePrevLow  = false
var bool neutralSincePrevHigh = false

if inNeutral
    neutralSincePrevLow  := true
    neutralSincePrevHigh := true

// ── Previous pivot storage ──────────────────────────────────────
var float prevPriceLow  = na
var float prevRsiLow    = na
var int   prevLowBar    = na

var float prevPriceHigh = na
var float prevRsiHigh   = na
var int   prevHighBar   = na

// ── Bullish divergence: price lower low, RSI higher low ────────
bullDiv = false
if not na(pricePivotLow)
    if not na(prevPriceLow) and not neutralSincePrevLow
        barsBetween = pivotBarIdx - prevLowBar
        if barsBetween > 0 and barsBetween <= maxBars
            if pricePivotLow < prevPriceLow and rsiAtPivot > prevRsiLow
                bullDiv := true
                line.new(prevLowBar, prevRsiLow, pivotBarIdx, rsiAtPivot, color=bullColor, width=lineWidth, style=line.style_solid)
                label.new(pivotBarIdx, rsiAtPivot - 2, "BULL", color=color.new(bullColor, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

    prevPriceLow := pricePivotLow
    prevRsiLow   := rsiAtPivot
    prevLowBar   := pivotBarIdx
    neutralSincePrevLow := false

// ── Bearish divergence: price higher high, RSI lower high ──────
bearDiv = false
if not na(pricePivotHigh)
    if not na(prevPriceHigh) and not neutralSincePrevHigh
        barsBetween = pivotBarIdx - prevHighBar
        if barsBetween > 0 and barsBetween <= maxBars
            if pricePivotHigh > prevPriceHigh and rsiAtPivot < prevRsiHigh
                bearDiv := true
                line.new(prevHighBar, prevRsiHigh, pivotBarIdx, rsiAtPivot, color=bearColor, width=lineWidth, style=line.style_solid)
                label.new(pivotBarIdx, rsiAtPivot + 2, "BEAR", color=color.new(bearColor, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

    prevPriceHigh := pricePivotHigh
    prevRsiHigh   := rsiAtPivot
    prevHighBar   := pivotBarIdx
    neutralSincePrevHigh := false

// ── Plotting ────────────────────────────────────────────────────
plot(rsi, "RSI", color.white, 2)

hline(70, "Overbought",  color.new(color.red, 70),   linestyle=hline.style_dotted)
hline(50, "Midline",     color.white,                  linestyle=hline.style_solid)
hline(30, "Oversold",    color.new(color.green, 70),  linestyle=hline.style_dotted)

neutralUpper = plot(neutralHi, "Neutral Hi", color.new(color.gray, 90))
neutralLower = plot(neutralLo, "Neutral Lo", color.new(color.gray, 90))
fill(neutralUpper, neutralLower, color.new(color.yellow, 92), title="Neutral Zone")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(bullDiv, "Bullish RSI Divergence", "Bullish RSI divergence detected")
alertcondition(bearDiv, "Bearish RSI Divergence", "Bearish RSI divergence detected")

// This Pine Script(TM) indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// OnATilt - RSI Divergence with Neutral Zone Reset
//@version=6
indicator("RSI Divergence (Neutral Reset)", overlay=false, max_lines_count=500, max_labels_count=500)

// ── Inputs ──────────────────────────────────────────────────────
rsiLen        = input.int(14,  "RSI Length")
pivotLookback = input.int(3,   "Pivot Lookback", minval=1, maxval=10)
maxBars       = input.int(14,  "Max Bars Between Pivots", minval=5, maxval=50)
neutralHi     = input.float(52.0, "Neutral Zone Upper")
neutralLo     = input.float(48.0, "Neutral Zone Lower")
bullColor     = input.color(color.green, "Bullish Divergence Color")
bearColor     = input.color(color.red,   "Bearish Divergence Color")
lineWidth     = input.int(2, "Divergence Line Width", minval=1, maxval=5)

// ── RSI ─────────────────────────────────────────────────────────
rsi = ta.rsi(close, rsiLen)

// ── Neutral zone detection ──────────────────────────────────────
// RSI in 48-52 resets any divergence in progress.
// A valid divergence requires RSI to have passed through 48-52
// BETWEEN the two pivot points (the divergence starts "after" the neutral visit).
inNeutral = rsi >= neutralLo and rsi <= neutralHi

// Track whether neutral was visited since the last stored pivot.
// This flag is set when RSI enters 48-52 and cleared when a new
// pivot is stored — ensuring the divergence pair straddles a neutral visit.
var bool neutralSincePrevLow  = false
var bool neutralSincePrevHigh = false

if inNeutral
    neutralSincePrevLow  := true
    neutralSincePrevHigh := true

// ── Pivot detection (RSI only) ──────────────────────────────────
rsiPivotLow  = ta.pivotlow(rsi,  pivotLookback, pivotLookback)
rsiPivotHigh = ta.pivothigh(rsi, pivotLookback, pivotLookback)

// Price at the pivot bar (lookback bars ago)
priceLowAtPivot  = low[pivotLookback]
priceHighAtPivot = high[pivotLookback]

// ── Track previous pivots ───────────────────────────────────────
var float prevRsiLow     = na
var float prevPriceLow   = na
var int   prevLowBar     = na

var float prevRsiHigh    = na
var float prevPriceHigh  = na
var int   prevHighBar    = na

pivotBarIndex = bar_index - pivotLookback

// ── Bullish divergence: price lower low, RSI higher low ────────
bullDiv = false
if not na(rsiPivotLow)
    if not na(prevRsiLow) and neutralSincePrevLow
        barsBetween = pivotBarIndex - prevLowBar
        if barsBetween > 0 and barsBetween <= maxBars
            if priceLowAtPivot < prevPriceLow and rsiPivotLow > prevRsiLow
                bullDiv := true
                line.new(prevLowBar, prevRsiLow, pivotBarIndex, rsiPivotLow, color=bullColor, width=lineWidth, style=line.style_solid)
                label.new(pivotBarIndex, rsiPivotLow - 2, "BULL", color=color.new(bullColor, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

    prevRsiLow   := rsiPivotLow
    prevPriceLow := priceLowAtPivot
    prevLowBar   := pivotBarIndex
    neutralSincePrevLow := false

// ── Bearish divergence: price higher high, RSI lower high ──────
bearDiv = false
if not na(rsiPivotHigh)
    if not na(prevRsiHigh) and neutralSincePrevHigh
        barsBetween = pivotBarIndex - prevHighBar
        if barsBetween > 0 and barsBetween <= maxBars
            if priceHighAtPivot > prevPriceHigh and rsiPivotHigh < prevRsiHigh
                bearDiv := true
                line.new(prevHighBar, prevRsiHigh, pivotBarIndex, rsiPivotHigh, color=bearColor, width=lineWidth, style=line.style_solid)
                label.new(pivotBarIndex, rsiPivotHigh + 2, "BEAR", color=color.new(bearColor, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

    prevRsiHigh   := rsiPivotHigh
    prevPriceHigh := priceHighAtPivot
    prevHighBar   := pivotBarIndex
    neutralSincePrevHigh := false

// ── Plotting ────────────────────────────────────────────────────
plot(rsi, "RSI", color.white, 2)

hline(70, "Overbought",  color.new(color.red, 70),   linestyle=hline.style_dotted)
hline(50, "Midline",     color.white,                  linestyle=hline.style_solid)
hline(30, "Oversold",    color.new(color.green, 70),  linestyle=hline.style_dotted)

neutralUpper = plot(neutralHi, "Neutral Hi", color.new(color.gray, 90))
neutralLower = plot(neutralLo, "Neutral Lo", color.new(color.gray, 90))
fill(neutralUpper, neutralLower, color.new(color.yellow, 92), title="Neutral Zone")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(bullDiv, "Bullish RSI Divergence", "Bullish RSI divergence detected after neutral reset")
alertcondition(bearDiv, "Bearish RSI Divergence", "Bearish RSI divergence detected after neutral reset")

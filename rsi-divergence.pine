// https://mozilla.org/MPL/2.0/
// OnATilt - RSI Divergence with Neutral Zone Reset
//@version=6
indicator("RSI Divergence (Neutral Reset)", overlay=false, max_lines_count=500, max_labels_count=500)

// ── Inputs ──────────────────────────────────────────────────────
rsiLen    = input.int(14,  "RSI Length")
window    = input.int(14,  "Divergence Window (bars)", minval=2, maxval=50)
neutralHi = input.float(52.0, "Neutral Zone Upper")
neutralLo = input.float(48.0, "Neutral Zone Lower")
bullColor = input.color(color.green, "Bullish Color")
bearColor = input.color(color.red,   "Bearish Color")
lineWidth = input.int(2, "Line Width", minval=1, maxval=5)

// ── RSI ─────────────────────────────────────────────────────────
rsi = ta.rsi(close, rsiLen)
inNeutral = rsi >= neutralLo and rsi <= neutralHi

// ── Window tracking ─────────────────────────────────────────────
// When RSI touches 48-52, start a new window. Store that bar's price & RSI.
var int   winBar   = na
var float winRsi   = na
var float winClose = na

if inNeutral
    winBar   := bar_index
    winRsi   := rsi
    winClose := close

// ── Divergence check at end of window ───────────────────────────
winAge = na(winBar) ? 0 : bar_index - winBar

bullDiv = false
bearDiv = false

if winAge == window
    priceDelta = close - winClose
    rsiDelta   = rsi - winRsi

    if priceDelta < 0 and rsiDelta > 0
        // Price down, RSI up → bullish divergence
        bullDiv := true
        line.new(winBar, winRsi, bar_index, rsi, color=bullColor, width=lineWidth, style=line.style_solid)
        label.new(bar_index, rsi - 2, "BULL", color=color.new(bullColor, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

    if priceDelta > 0 and rsiDelta < 0
        // Price up, RSI down → bearish divergence
        bearDiv := true
        line.new(winBar, winRsi, bar_index, rsi, color=bearColor, width=lineWidth, style=line.style_solid)
        label.new(bar_index, rsi + 2, "BEAR", color=color.new(bearColor, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

// ── Plotting ────────────────────────────────────────────────────
plot(rsi, "RSI", color.white, 2)

hline(70, "Overbought",  color.new(color.red, 70),   linestyle=hline.style_dotted)
hline(50, "Midline",     color.white,                  linestyle=hline.style_solid)
hline(30, "Oversold",    color.new(color.green, 70),  linestyle=hline.style_dotted)

neutralUpper = plot(neutralHi, "Neutral Hi", color.new(color.gray, 90))
neutralLower = plot(neutralLo, "Neutral Lo", color.new(color.gray, 90))
fill(neutralUpper, neutralLower, color.new(color.yellow, 92), title="Neutral Zone")

// ── Alerts ──────────────────────────────────────────────────────
alertcondition(bullDiv, "Bullish RSI Divergence", "Bullish RSI divergence detected after neutral reset")
alertcondition(bearDiv, "Bearish RSI Divergence", "Bearish RSI divergence detected after neutral reset")
